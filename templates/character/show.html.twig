{% extends 'base.html.twig' %}
{% block title %}{{ character.name }} · Character{% endblock %}
{% block body %}<main class="container-xl py-4">
<a href="{{ path('script_characters', character.script.rp) }}">← {{ character.script.title }} · Cast</a>
<h1>{{ character.name }}</h1>
<p>{{ character.appearance.description|default('Minimal character study') }}</p>
<div class="card mb-4"><div class="card-body d-flex align-items-center gap-3"><strong>Poses: {{ character.marking }}</strong>
{% if workflow_can(character, 'build', 'character') %}<form method="post" action="{{ path('character_build', {id:character.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('poses-' ~ character.id) }}"><button class="btn btn-primary">{{ character.poseAssets ? 'Rebuild' : 'Build' }} poses</button></form>{% endif %}
<a href="{{ path('character_rehearse', character.script.rp|merge(character.rp)) }}">Rehearse lines</a></div></div>
<section class="card mb-4"><div class="card-body"><h2 class="h4">Voice</h2><p>Age {{ character.age|default("unspecified") }} · {{ character.gender|default("gender unspecified") }} — shared with pose generation.</p>
<form method="post" action="{{ path('character_voice', {id:character.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('voice-' ~ character.id) }}">
<label for="voice-description" class="form-label">Describe the voice</label>
<textarea id="voice-description" class="form-control mb-3" name="description" rows="3" placeholder="A warm elderly British storyteller, slightly raspy">{{ character.voiceDescription }}</textarea>
<label for="voice-design" class="form-label">Voice design tags</label>
<input id="voice-design" class="form-control mb-2" name="design" value="{{ character.voiceProfile.voicestudio.design|default('') }}" placeholder="female, middle-aged, moderate pitch, american accent">
<p class="small text-secondary">This is the character’s usual voice. Individual lines add delivery directions, such as whispered or angry. OmniVoice uses the design tags; its support for free-form acting directions is limited.</p>
<button class="btn btn-primary">Save voice</button></form></div></section>
<section class="mb-4"><h2 class="h4">Line performances</h2>
{% for line in lines %}<div class="card mb-2"><div class="card-body"><blockquote>{{ line.text }}</blockquote>
<form method="post" action="{{ path('line_voice_generate', {id:line.id}) }}" class="d-flex flex-wrap gap-2 align-items-center">
<input type="hidden" name="_token" value="{{ csrf_token('line-voice-' ~ line.id) }}">
<input name="delivery" class="form-control" aria-label="Delivery direction" value="{{ line.delivery }}" placeholder="How should this line be said?">
<select name="style" class="form-select w-auto" aria-label="Delivery style"><option value="normal">Normal voice</option><option value="whisper" {{ 'vol=x-soft' in (line.notes|default([])|join(' ')) ? 'selected' : '' }}>Whisper</option></select>
<select name="pace" class="form-select w-auto" aria-label="Pace">{% for pace in ['medium','slow','fast'] %}<option value="{{ pace }}" {{ ('pace=' ~ pace) in (line.notes|default([])|join(' ')) ? 'selected' : '' }}>{{ pace|capitalize }} pace</option>{% endfor %}</select>
<button class="btn btn-outline-primary">Generate line</button><span>{{ line.speech.marking|default('No recording') }}</span>
</form>{% if line.speech.audioUrl|default(null) %}<audio class="mt-2" controls preload="none" src="{{ line.speech.audioUrl }}"></audio>{% endif %}
</div></div>{% endfor %}</section>
{% for pose in character.poses %}<h2 class="h3">{{ pose|replace({'-':' '})|title }}</h2><div class="row g-2 mb-4">
{% for expression in ['neutral','amused','concerned','skeptical','angry','surprised'] %}{% set key = pose ~ '/' ~ expression ~ '/rest' %}
{% if character.poseAssets[key] is defined %}<figure class="col-6 col-md-2"><div class="card p-2"><img src="{{ character.poseAssets[key] }}" alt="{{ character.name }} · {{ pose }} · {{ expression }}" style="height:180px;object-fit:contain"><figcaption class="text-center">{{ expression }} · <a href="{{ character.poseAssets[pose ~ '/' ~ expression ~ '/speaking'] }}">speaking</a></figcaption></div></figure>{% endif %}
{% endfor %}</div>{% else %}<p>No poses specified yet.</p>{% endfor %}
<p class="text-secondary small">SVG poses rendered locally with <a href="https://github.com/namuan/sticky-fig">StickyFig</a> (MIT). No model calls.</p>
</main>{% endblock %}
