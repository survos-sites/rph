{% extends 'base.html.twig' %}
{% block title %}Rehearse {{ character.name }} · {{ script.title }}{% endblock %}
{% block body %}<div class="page-body"><main class="container-xl" style="max-width: 58rem"><div class="alert alert-info"><strong>{{ character.name }}</strong> is highlighted. Other dialogue provides cues and context.</div>{% for scene in script.scenes %}{% set hasLines = false %}{% for element in scene.elements %}{% if element.character and element.character.id == character.id %}{% set hasLines = true %}{% endif %}{% endfor %}{% if hasLines %}<section class="card mb-4"><div class="card-header"><h2 class="card-title">Scene {{ scene.sequence }} — {{ scene.heading }}</h2></div><div class="card-body font-monospace">{% include 'script/_elements.html.twig' with {elements: scene.elements, character: character} only %}</div></section>{% endif %}{% endfor %}</main></div>{% endblock %}
