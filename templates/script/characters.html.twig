{% extends 'base.html.twig' %}
{% block title %}Characters in {{ script.title }}{% endblock %}
{% block body %}<div class="page-body"><div class="container-xl"><div class="row row-cards">{% for character in script.characters %}<div class="col-sm-6 col-lg-4"><a class="card card-link" href="{{ path('character_rehearse', script.rp|merge(character.rp)) }}"><div class="card-body"><h2 class="card-title">{{ character.name }}</h2><div class="text-secondary">Open rehearsal view</div></div></a></div>{% endfor %}</div></div></div>{% endblock %}
