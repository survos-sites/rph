{% extends 'base.html.twig' %}

{% block title %}Role Playhouse{% endblock %}

{% block body %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <h1>Role Playhouse</h1>
            <p class="text-secondary">Import, read, cast, and rehearse Fountain and Celtx scripts.</p>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards">
                {% for script in scripts %}
                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100">
                            {% set preview = previews[script.id]|default(null) %}
                            {% if preview %}<a href="{{ path('scene_shotlist', {scriptId: script.id, sceneId: preview.sceneId}) }}"><img class="card-img-top" src="{{ preview.image }}" alt="{{ preview.description }}" loading="lazy" style="aspect-ratio: 16/9; object-fit: cover"></a>{% endif %}
                            <div class="card-body">
                                <h2 class="card-title"><a href="{{ path('script_overview', script.rp) }}">{{ script.title }}</a></h2>
                                {% if script.author %}<p class="text-secondary">by {{ script.author }}</p>{% endif %}
                                <div class="text-secondary">{{ script.scenes.count }} scenes · {{ script.characters.count }} characters</div>
                                <div class="btn-list mt-3">
                                    {% if preview %}<a class="btn btn-sm btn-primary" href="{{ path('scene_shotlist', {scriptId: script.id, sceneId: preview.sceneId}) }}">Illustrated scene</a>{% endif %}
                                    {% if script.scenes|length %}<a class="btn btn-sm btn-primary" href="{{ path('scene_player', script.rp|merge(script.scenes.first.rp)) }}">Play scenes</a>{% endif %}
                                    <a class="btn btn-sm" href="{{ path('script_show', script.rp) }}">Read</a>
                                    <a class="btn btn-sm btn-primary" href="{{ path('script_characters', script.rp) }}">Rehearse</a>
                                </div>
                                {% if preview %}<p class="small text-secondary mt-3 mb-0">Script: <a href="{{ preview.sourceUrl }}">{{ preview.author }}</a> · <a href="{{ preview.licenseUrl }}">{{ preview.license }}</a><br>AI-generated scene reference</p>{% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-info">Run <code>bin/console app:load path/to/script.fountain</code> to import a script.</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
