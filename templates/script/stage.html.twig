{% extends 'base.html.twig' %}
{% block title %}{{ script.title }} · Scene {{ scene.sequence }} · 3D stage{% endblock %}
{% block body %}
<div class="page-body" data-controller="vrm-stage" data-vrm-stage-payload-value="{{ payload|json_encode }}">
    <main class="container-xl">
        <header class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <div><a class="text-secondary" href="{{ path('scene_player', script.rp|merge(scene.rp)) }}">← Scene player</a><h1 class="mt-2 mb-1">Scene {{ scene.sequence }} · 3D stage</h1><p class="text-secondary mb-0">{{ scene.heading }}</p></div>
            <div class="d-flex gap-2 align-items-center"><label for="stage-scene" class="visually-hidden">Scene</label><select id="stage-scene" class="form-select" data-action="change->vrm-stage#changeScene">{% for item in payload.scenes %}<option value="{{ path('scene_stage', {scriptId: script.id, sceneId: item.id}) }}" {{ item.id == scene.id ? 'selected' }}>{{ item.sequence }} · {{ item.heading }}</option>{% endfor %}</select></div>
        </header>
        <div class="card">
            <div class="rph-stage" data-vrm-stage-target="viewport">
                <div class="rph-stage-subtitle" data-vrm-stage-target="subtitle" aria-live="polite"></div>
            </div>
            <div class="card-footer d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="btn-list"><button class="btn" data-action="vrm-stage#previous">← Back</button><button class="btn btn-primary" data-action="vrm-stage#toggle" data-vrm-stage-target="play" disabled>Loading…</button><button class="btn" data-action="vrm-stage#next">Next →</button><button class="btn btn-ghost-secondary" data-action="vrm-stage#restart">Restart</button></div>
                <span class="small text-secondary" data-vrm-stage-target="status" role="status">Loading characters…</span>
            </div>
        </div>
        <p class="text-secondary small mt-3">Prototype: VRM sample models (VRM Public License 1.0) stand in for the cast. Expressions come from parentheticals; the mouth follows the voice audio.</p>
    </main>
</div>
{% endblock %}
