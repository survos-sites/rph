{% extends 'base.html.twig' %}
{% block title %}{{ scene.heading }} · {{ script.title }}{% endblock %}
{% block body %}<div class="page-body"><main class="container-xl" style="max-width: 58rem"><div class="card"><div class="card-header"><h1 class="card-title text-uppercase">Scene {{ scene.sequence }} — {{ scene.heading }}</h1></div><div class="card-body font-monospace">{% include 'script/_elements.html.twig' with {elements: scene.elements} only %}</div></div><div class="d-flex justify-content-between mt-3">{% set previous = script.scenes[scene.sequence - 2]|default(null) %}{% set next = script.scenes[scene.sequence]|default(null) %}{% if previous %}<a class="btn" href="{{ path('scene_show', script.rp|merge(previous.rp)) }}">← Previous scene</a>{% else %}<span></span>{% endif %}{% if next %}<a class="btn btn-primary" href="{{ path('scene_show', script.rp|merge(next.rp)) }}">Next scene →</a>{% endif %}</div></main></div>{% endblock %}
