{% extends 'base.html.twig' %}
{% block title %}Scenes in {{ script.title }}{% endblock %}
{% block body %}<div class="page-body"><div class="container-xl"><div class="row row-cards">{% for scene in script.scenes %}<div class="col-md-6"><a class="card card-link" href="{{ path('scene_show', script.rp|merge(scene.rp)) }}"><div class="card-body"><span class="badge bg-blue-lt me-2">Scene {{ scene.sequence }}</span>{{ scene.heading }}<div class="text-secondary mt-2">{{ scene.elements.count }} elements</div></div></a></div>{% endfor %}</div></div></div>{% endblock %}
