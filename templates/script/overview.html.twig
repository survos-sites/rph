{% extends 'base.html.twig' %}
{% block title %}{{ script.title }} overview{% endblock %}
{% block body %}
    <div class="page-body"><div class="container-xl">
        <div class="row row-cards mb-4">
            <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body"><div class="h1 mb-0">{{ script.scenes.count }}</div><div class="text-secondary">Scenes</div></div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body"><div class="h1 mb-0">{{ script.characters.count }}</div><div class="text-secondary">Characters</div></div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body"><div class="h1 mb-0">{{ script.scenes|reduce((count, scene) => count + scene.elements.count, 0)|number_format }}</div><div class="text-secondary">Script elements</div></div></div></div>
        </div>
        <div class="row row-cards">
            <div class="col-lg-6"><div class="card h-100"><div class="card-header"><h2 class="card-title">Walk the scenes</h2></div><div class="list-group list-group-flush">{% for scene in script.scenes %}<a class="list-group-item list-group-item-action" href="{{ path('scene_show', script.rp|merge(scene.rp)) }}"><span class="badge bg-blue-lt me-2">{{ scene.sequence }}</span>{{ scene.heading }}</a>{% endfor %}</div></div></div>
            <div class="col-lg-6"><div class="card h-100"><div class="card-header"><h2 class="card-title">Rehearse a character</h2></div><div class="list-group list-group-flush">{% for character in script.characters %}<a class="list-group-item list-group-item-action" href="{{ path('character_rehearse', script.rp|merge(character.rp)) }}">{{ character.name }}</a>{% endfor %}</div></div></div>
        </div>
    </div></div>
{% endblock %}
