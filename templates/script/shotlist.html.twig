{% extends 'base.html.twig' %}
{% block title %}{{ script.title }} · Shotlist{% endblock %}
{% block body %}
<div class="page-body rph-player rph-shotlist" data-controller="scene-player" data-action="keydown@window->scene-player#navigate" data-scene-player-shotlist-value="true" data-scene-player-payload-value="{{ payload|json_encode }}">
<main class="container-xl">
<header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
<div><a href="{{ path('script_overview', script.rp) }}">← {{ script.title }}</a><h1 class="mt-2 mb-1">Scene {{ scene.sequence }} · Shotlist</h1><p class="text-secondary mb-0">{{ scene.heading }} · Static shots and script notes</p></div>
<div class="d-flex flex-wrap gap-2"><label for="shotlist-scene" class="visually-hidden">Scene</label><select id="shotlist-scene" class="form-select" data-action="change->scene-player#changeScene">{% for item in payload.scenes %}<option value="{{ item.shotlistUrl }}" {{ item.id == scene.id ? 'selected' }}>{{ item.sequence }} · {{ item.heading }}</option>{% endfor %}</select><label for="shot-jump" class="visually-hidden">Shot</label><select id="shot-jump" class="form-select" data-scene-player-target="shotSelect" data-action="change->scene-player#chooseShot">{% for item in payload.elements %}<option value="{{ loop.index0 }}">{{ loop.index }} · {{ item.speaker|default(item.type|capitalize, true) }}</option>{% endfor %}</select><a class="btn" href="{{ path('scene_player', script.rp|merge(scene.rp)) }}">Dialogue viewer</a></div>
</header>
<section class="card rph-shot-viewer">
<div class="rph-shot-stage">
<img data-scene-player-target="shot" class="rph-shot-image" alt="Scene reference" {% if payload.elements[0].shot|default(null) %}src="{{ payload.elements[0].shot }}"{% else %}hidden{% endif %}>
<div class="rph-shot-placeholder" data-scene-player-target="placeholder" {{ payload.elements[0].shot|default(null) ? 'hidden' }}>No still image yet. The script remains the shot reference.</div>
<div class="rph-shot-subtitles"><div class="d-flex justify-content-between gap-3 mb-2"><span data-scene-player-target="kind" class="text-uppercase small"></span><span data-scene-player-target="counter" class="small"></span></div><p class="rph-shot-action mb-2"><em data-scene-player-target="direction"></em></p><strong data-scene-player-target="speaker"></strong><p data-scene-player-target="text" class="mb-0 mt-1"></p></div>
</div>
<div class="card-body"><div class="d-flex flex-wrap justify-content-between gap-3"><div class="btn-list"><button class="btn" data-action="scene-player#previous" aria-label="Previous shot">← Previous</button><button class="btn btn-primary" data-action="scene-player#toggle" data-scene-player-target="play">Slideshow</button><button class="btn" data-action="scene-player#next" aria-label="Next shot">Next →</button><button class="btn btn-ghost-secondary" data-action="scene-player#restart">Restart</button></div><label class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" data-scene-player-target="voice" data-action="change->scene-player#voiceChanged"><span class="form-check-label">Local voice</span></label></div>
<span class="text-secondary small" data-scene-player-target="framing"></span><span class="text-secondary small"><kbd>←</kbd> / <kbd>→</kbd> change shots</span><p class="text-secondary small mb-0" role="status" data-scene-player-target="status">Choose a shot or start the slideshow.</p><audio data-scene-player-target="audio" preload="none" hidden></audio></div>
</section>
</main></div>
{% endblock %}
