{% extends 'base.html.twig' %}
{% block title %}Prompter · {{ script.title }}{% endblock %}
{% block body %}<div class="page-body"><main class="container-xl" style="max-width: 64rem"><div class="text-center mb-5"><h1 class="display-3">{{ script.title }}</h1><p class="text-secondary">Use the browser’s scrolling or presentation controls.</p></div>{% for scene in script.scenes %}<section class="mb-5"><h2 class="text-center text-uppercase border-bottom pb-3 mb-4">{{ scene.heading }}</h2><div class="fs-2 lh-lg">{% for element in scene.elements %}{% if element.type.value == 'dialogue' %}<p><strong>{{ element.character.name|default('') }}:</strong> {{ element.text|nl2br }}</p>{% elseif element.type.value == 'action' %}<p class="text-secondary fst-italic">{{ element.text|nl2br }}</p>{% endif %}{% endfor %}</div></section>{% endfor %}</main></div>{% endblock %}
