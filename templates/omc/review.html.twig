<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ review.title }} — Edit review</title>
<style>body{font:17px/1.5 system-ui;background:#f3f0e9;color:#25323a;max-width:1250px;margin:32px auto;padding:0 24px}h1{font-family:Georgia,serif}a{color:#126278}article{background:white;padding:24px;margin:24px 0;border-radius:12px;border:1px solid #d5d8d5}.columns{display:grid;grid-template-columns:minmax(280px,1fr) minmax(280px,1fr);gap:24px}img{width:100%;background:#26333e}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px}.timing{font-variant-numeric:tabular-nums;color:#52616b}.flag{border-left:3px solid #b88033;padding-left:12px}summary{cursor:pointer;font-weight:600}@media(max-width:750px){.columns{display:block}}</style>
<h1>{{ review.title }} · Visual script review</h1><p>One section per visual change, in playback order. <a href="{{ path('omc_review_json',{slug:slug}) }}">AI review JSON</a> · <a href="{{ path('omc_review_screenplay',{slug:slug}) }}">Script with inline visual cues</a> · <a href="{{ path('omc_otio',{slug:slug}) }}">OTIO</a> · <a href="{{ path('omc_show',{slug:slug}) }}">Movie</a></p>
<p>{{ review.timingConvention }}</p><p>Descriptions are authored intent. Prompts from older artwork are preserved separately; they are not presented as the prompts for the current SVG or Unity render.</p>
{% for shot in review.shots %}<article id="shot-{{ shot.index }}"><h2>Image {{ shot.index }} · {{ shot.name }}</h2><p class="timing">{{ shot.startSeconds|number_format(2) }}–{{ shot.endSeconds|number_format(2) }}s · {{ shot.durationSeconds|number_format(2) }}s · frames {{ shot.startFrame }}–{{ shot.endFrame }} · {{ shot.framing }}</p><div class="columns"><div>{% if shot.image %}<a href="{{ shot.media.url }}"><img loading="lazy" src="{{ shot.image }}" alt="Authored description: {{ shot.description }}"></a>{% else %}<p>No preview image recorded.</p>{% endif %}<p>{{ shot.description }}</p><p><strong>{{ shot.scene }}</strong></p>{% if shot.media.kind == 'video' %}<p>Video poster only. <a href="{{ shot.media.url }}">Inspect moving shot</a>.</p>{% endif %}</div><div><h3>What we hear</h3>{% for audio in shot.audio %}<p><span class="timing">{{ (audio.startFrame/review.fps)|number_format(2) }}–{{ (audio.endFrame/review.fps)|number_format(2) }}s · {{ audio.track }}</span><br>{{ audio.name }}</p>{% if audio.line %}<p><strong>Audio {{ audio.audioReference }}</strong><audio controls preload="none" src="{{ audio.media.url }}" aria-label="Audio {{ audio.audioReference }}: {{ audio.name }}" style="display:block;width:100%;margin:8px 0"></audio><a href="{{ audio.media.url }}">Open MP3</a> · <small>Line {{ audio.elementId }}</small></p><small>Delivery: {{ audio.line.direction|json_encode }}</small>{% endif %}{% else %}<p>No audio clips overlap this shot.</p>{% endfor %}<h3>Incoming transition</h3><p>{{ shot.incomingTransition.previousShot ?? 'Start' }} → {{ shot.name }} · {{ shot.incomingTransition.type }}</p>{% for flag in shot.incomingTransition.flags %}<p class="flag">{{ flag }}</p>{% endfor %}</div></div><details><summary>Generation recipe, prompt history and provenance</summary><pre>{{ shot.generation|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details><details><summary>Exact edit and audio data</summary><pre>{{ shot|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details></article>{% endfor %}</html>
