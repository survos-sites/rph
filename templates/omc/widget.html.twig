<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ model.title }} · Preview</title><style>body{margin:0;background:#17232b;color:#eee;font:16px system-ui}header{padding:12px 16px}#stage{aspect-ratio:16/9}#stage-wrap{position:relative}#draft-caption{position:absolute;bottom:18px;left:8%;right:8%;text-align:center;pointer-events:none}#draft-caption span{background:#111e;color:white;padding:5px 10px;box-decoration-break:clone;line-height:1.65;font-size:clamp(16px,2vw,26px)}button{padding:8px 14px;margin:10px;cursor:pointer}#status{padding:0 14px;color:#cbd5da}</style>
{{ importmap('app') }}
<header>{{ model.title }}{% if model.scene %} · Starting at Scene {{ model.scene }}{% else %} · Entire movie{% endif %}</header><div id="stage-wrap"><div id="stage"></div><div id="draft-caption" aria-live="off"></div></div><label><input type="checkbox" id="silent-review"> Subtitle-only review (all sound off)</label><label style="margin-left:16px"><input type="checkbox" id="scene-stop"> Stop at scene end</label><button id="restart">Play from beginning{% if model.scene %} of scene{% endif %}</button><p id="scene-label"></p><span id="status">Loading…</span>
<script type="module">
import {sceneBoundary} from '{{ asset('scene-stop.js') }}';
import {mountOtioPlayer} from '@survos/otio-bundle/player';
const model={{ model|json_encode(constant('JSON_HEX_TAG'))|raw }};
const requestedStart=new URLSearchParams(location.search).get('start');
if(requestedStart!==null && Number.isFinite(Number(requestedStart)) && Number(requestedStart)>=0)model.startFrame=Math.min(model.movieEndFrame-1,Math.round(Number(requestedStart)*model.fps));
const stage=document.getElementById('stage'),status=document.getElementById('status');
try {
 const response=await fetch(model.playbackUrl);if(!response.ok)throw new Error('Could not load timeline');
 const projection=await response.json();
 const silent=new URLSearchParams(location.search).get('review')==='subtitles';
 document.getElementById('silent-review').checked=silent;
 document.getElementById('silent-review').onchange=event=>{const url=new URL(location.href);if(event.target.checked)url.searchParams.set('review','subtitles');else url.searchParams.delete('review');location.replace(url);};
 if(silent)for(const clip of projection.clips){clip.gain=0;clip.muted=true;}
 const player=mountOtioPlayer(stage,projection);
 let initialized=false, previousFrame=null;
 const sceneStop=document.getElementById('scene-stop');
 sceneStop.checked=localStorage.getItem('rph.sceneStop')==='true';
 sceneStop.onchange=()=>{localStorage.setItem('rph.sceneStop',String(sceneStop.checked));previousFrame=null;};
 stage.addEventListener('otio:frame',event=>{
  const frame=event.detail.frame;
  const boundary=sceneBoundary(previousFrame,frame,model.sceneLabels,sceneStop.checked,model.fps);
  previousFrame=frame;
  if(boundary!==null){player.pause();previousFrame=boundary;player.seekTo(boundary);}
  const cue=model.dialogueCues.find(c=>c.start<=frame && frame<c.end);
  const caption=document.getElementById('draft-caption');caption.replaceChildren();
  if(cue){const span=document.createElement('span');span.textContent=cue.reference+' · '+cue.speaker+': '+cue.text+(cue.direction.audioStatus==='stale' ? ' [draft voice pending]' : '');caption.append(span);}
  const label=model.sceneLabels.find(s=>s.start<=frame && frame<s.end);
  document.getElementById('scene-label').textContent='Revision '+model.revision+(label ? ' · Scene '+label.scene+' · '+label.heading+' · '+label.shot : ' · Transition');
  status.textContent=(frame/model.fps).toFixed(1)+' / '+model.movieDurationSeconds.toFixed(1)+'s';
 });
 document.getElementById('restart').onclick=()=>{initialized=true;previousFrame=null;player.seekTo(model.startFrame);player.play();};
 status.textContent='Ready · '+model.movieDurationSeconds.toFixed(1)+' seconds · continues through the movie';
 // React mounts asynchronously; the explicit play button seeks once its controls are available.
 stage.addEventListener('otio:play',()=>{if(!initialized){initialized=true;player.seekTo(model.startFrame);}});
 window.addEventListener('pagehide',()=>player.unmount(),{once:true});
}catch(error){status.textContent=error.message;}
</script></html>
