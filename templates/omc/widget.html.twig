<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ model.title }} · Preview</title><style>body{margin:0;background:#17232b;color:#eee;font:16px system-ui}header{padding:12px 16px}#stage{aspect-ratio:16/9}button{padding:8px 14px;margin:10px;cursor:pointer}#status{padding:0 14px;color:#cbd5da}</style>
{{ importmap('app') }}
<header>{{ model.title }}{% if model.scene %} · Scene {{ model.scene }}{% else %} · Entire movie{% endif %}</header><div id="stage"></div><button id="restart">Play from beginning{% if model.scene %} of scene{% endif %}</button><span id="status">Loading…</span>
<script type="module">
import {mountOtioPlayer} from '@survos/otio-bundle/player';
const model={{ model|json_encode(constant('JSON_HEX_TAG'))|raw }};
const stage=document.getElementById('stage'),status=document.getElementById('status');
try {
 const response=await fetch(model.playbackUrl);if(!response.ok)throw new Error('Could not load timeline');
 const projection=await response.json();const player=mountOtioPlayer(stage,projection);
 let initialized=false;
 stage.addEventListener('otio:frame',event=>{
  const frame=event.detail.frame;
  if(model.scene && frame>=model.endFrame)player.pause();
  status.textContent=((Math.max(0,frame-model.startFrame))/model.fps).toFixed(1)+' / '+model.durationSeconds.toFixed(1)+'s';
 });
 document.getElementById('restart').onclick=()=>{player.seekTo(model.startFrame);player.play();};
 status.textContent='Ready · '+model.durationSeconds.toFixed(1)+' seconds';
 // React mounts asynchronously; the explicit play button seeks once its controls are available.
 stage.addEventListener('otio:play',()=>{if(!initialized){initialized=true;player.seekTo(model.startFrame);}});
 window.addEventListener('pagehide',()=>player.unmount(),{once:true});
}catch(error){status.textContent=error.message;}
</script></html>
