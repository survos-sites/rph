<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ review.title }} · Illustrated script</title>
<style>body{margin:0;background:#eeeae2;color:#28333b;font:18px/1.65 system-ui}main{max-width:900px;margin:auto;padding:40px 24px}h1{font:48px/1.15 Georgia,serif;margin:12px 0}header{margin-bottom:45px}a{color:#286d78}article{background:#fffdf8;padding:32px;margin:28px 0;border-radius:8px;box-shadow:0 2px 12px #25313b0b}h2{font-size:17px;letter-spacing:.08em;text-transform:uppercase;border-bottom:1px solid #ded9cb;padding-bottom:14px}.time{font-size:14px;color:#63737c;font-variant-numeric:tabular-nums}figure{margin:20px 0}img{width:100%;display:block;border-radius:5px;background:#25313b}figcaption{font-size:14px;color:#63737c;margin-top:8px}.action{font-family:Georgia,serif;font-size:20px}.dialogue{margin:26px auto;max-width:580px}.speaker{font-size:14px;font-weight:750;letter-spacing:.1em;margin-bottom:4px}.words{margin:0;font-size:21px}.quiet{padding:14px 18px;background:#f3eddf;border-left:3px solid #bb934b;font-size:16px}.sound{font-size:14px;color:#647278}summary{cursor:pointer;color:#647278;font-size:14px}pre{font-size:12px;white-space:pre-wrap;overflow-wrap:anywhere}@media(max-width:600px){main{padding:24px 12px}article{padding:18px}h1{font-size:36px}}</style>
<main><header><p class="time">ILLUSTRATED SCRIPT · CURRENT EDIT</p><h1>{{ review.title }}</h1><p>Pictures, action and dialogue in playback order. Timing is approximate for reading; pauses are shown explicitly.</p><nav><a href="{{ path('omc_show',{slug}) }}">Watch movie</a> · <a href="{{ path('omc_review',{slug}) }}">Technical review</a> · <a href="{{ path('omc_review_screenplay',{slug}) }}">Text export</a></nav></header>
{% set previousScene = null %}{% for shot in review.shots %}<article id="shot-{{ shot.index }}">{% if shot.scene and shot.scene != previousScene %}<h2>{{ shot.scene }}</h2>{% set previousScene = shot.scene %}{% endif %}<div class="time"><strong>Image {{ shot.index }}</strong> · {{ shot.startSeconds|number_format(1) }}–{{ shot.endSeconds|number_format(1) }} seconds · {{ shot.durationSeconds|number_format(1) }} second shot</div>
{% if shot.image %}<figure><a href="{{ shot.media.url }}"><img loading="lazy" src="{{ shot.image }}" alt="{{ shot.description ?? shot.name }}"></a>{% if shot.media.kind == 'video' %}<figcaption>Moving shot — click to play the source clip.</figcaption>{% endif %}</figure>{% endif %}
<p class="action">{{ shot.description ?? (shot.name ?: 'Black screen / transition.') }}</p>
{% for beat in shot.readingBeats %}{% if beat.kind == 'quiet' %}<p class="quiet"><strong>{{ beat.seconds|number_format(1) }} seconds without dialogue.</strong> {{ beat.sound }}</p>{% else %}<div class="dialogue"><div class="speaker">{{ beat.speaker }}{% if beat.continues %} <span class="time">(continues over this image)</span>{% endif %}</div><p class="words">{{ beat.text }}</p><p class="time"><strong>Audio {{ beat.audioReference }}</strong> · Line {{ beat.elementId }}</p><audio controls preload="none" src="{{ beat.audioUrl }}" aria-label="Audio {{ beat.audioReference }}: {{ beat.text }}" style="width:100%"></audio>{% if beat.delivery %}<p class="sound">({{ beat.delivery }})</p>{% endif %}</div>{% endif %}{% endfor %}
<details><summary>Image recipe and original prompt</summary><pre>{{ shot.generation|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details></article>{% endfor %}</main></html>
