{% extends 'base.html.twig' %}
{% block title %}{{ project.name }} · Production catalog{% endblock %}
{% block body %}
<main class="container-xl py-4" data-controller="omc-preview" data-omc-preview-url-value="{{ path('omc_playback',{slug}) }}">
    <header class="mb-4"><div class="d-flex justify-content-between"><a href="{{ path('omc_show',{slug:'xmas'}) }}">Christmas, Facing West</a><a href="{{ path('omc_show',{slug:'last-train'}) }}">The Last Train</a></div><h1 class="mt-3">{{ project.name }}</h1><p class="text-secondary">Production catalog · {{ characters|length }} roles · {{ scenes|length }} scenes · {{ shots|length }} storyboard frames</p>
    <nav class="d-flex flex-wrap gap-3"><a href="{{ path('omc_review',{slug}) }}">Edit review</a><a href="{{ path('omc_illustrated_script',{slug}) }}">Illustrated script</a><a href="{{ path('omc_review_screenplay',{slug}) }}">Script with visual cues</a><a href="#casting">Casting call</a><a href="#props">Props list</a><a href="#sets">Set designer</a><a href="#wardrobe">Wardrobe</a><a href="#shots">Shot list</a><a href="{{ path('omc_catalog',{slug}) }}">OMC JSON</a><a href="{{ path('omc_otio',{slug}) }}">OTIO timeline</a></nav></header>
    <div class="card overflow-hidden mb-4"><div data-omc-preview-target="stage" style="aspect-ratio:16/9;background:#000"></div><div class="card-footer text-secondary small">Existing performances with storyboard artwork. Click a shot below to jump to that moment.</div></div>
    <section id="shots" class="mb-5"><h2>Shot list</h2><div class="row g-3">{% for shot in shots %}<div class="col-6 col-md-3"><button class="card w-100 h-100 text-start p-0 overflow-hidden" data-action="omc-preview#seek" data-frame="{{ shot.data.startFrame|default(0) }}" {% if shot.data.startFrame is not defined %}disabled{% endif %}>
    {% if shot.image %}<img src="{{ shot.image }}" alt="{{ shot.entity.name }}" loading="lazy" style="width:100%;aspect-ratio:16/9;object-fit:cover">{% endif %}<span class="card-body"><strong>{{ shot.data.sequence }} · {{ shot.entity.name }}</strong><small class="d-block text-secondary">{{ shot.data.framing|default('') }}{% if shot.data.startFrame is defined %} · {{ (shot.data.startFrame / fps)|number_format(1) }}s{% endif %}</small></span></button></div>{% endfor %}</div></section>
    <section id="casting" class="mb-5"><h2>Casting call</h2><p class="text-secondary">Role briefs for performers or character generation. Unspecified traits remain open.</p><div class="row g-3">{% for row in characters %}<article class="col-md-6"><div class="card h-100"><div class="card-body"><h3>{{ row.entity.name }}</h3><p>{{ row.entity.description|default('Description needed.') }}</p>{% if row.character.visualDescription|default(null) %}<p><strong>Appearance:</strong> {{ row.character.visualDescription }}</p>{% endif %}{% if row.character.voice.description|default(null) %}<p><strong>Voice:</strong> {{ row.character.voice.description }}</p>{% endif %}<p class="small text-secondary mb-0">Scenes: {{ row.scenes|keys|join(', ') ?: 'Not assigned' }}</p></div></div></article>{% endfor %}</div></section>
    {% for section in [{id:'props',title:'Props list',rows:props},{id:'sets',title:'Set designer',rows:locations},{id:'wardrobe',title:'Wardrobe',rows:wardrobe}] %}
    <section id="{{ section.id }}" class="mb-5"><h2>{{ section.title }}</h2><div class="table-responsive"><table class="table table-vcenter"><thead><tr><th>Item</th><th>Brief</th><th>Scenes</th></tr></thead><tbody>{% for row in section.rows %}<tr><td>{{ row.entity.name }}</td><td>{{ row.entity.description|default('Description needed.') }}</td><td class="text-nowrap">{{ row.scenes|keys|join(', ') ?: 'Not assigned' }}</td></tr>{% else %}<tr><td colspan="3">No definitions yet.</td></tr>{% endfor %}</tbody></table></div></section>{% endfor %}
</main>
{% endblock %}
