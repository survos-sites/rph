            "cues": [
                {
                    "id": "cue-01",
                    "sceneId": "shot-1",
                    "sceneNumber": 1,
                    "heading": "Wide two-shot",
                    "type": "dialogue",
                    "speaker": "Mara Vale",
                    "text": "The last train was supposed to leave eight minutes ago.",
                    "startFrame": 0,
                    "durationFrames": 94,
                    "expressions": {
                        "mara": "concerned",
                        "eli": "neutral"
                    },
                    "shot": "wide",
                    "action": "Mara checks the empty platform.",
                    "audio": "/media/voices/1fa50e25bad58b4658c529f8cd8fa51f296743c1d3ccdb94f63c1047fdb96004.mp3",
                    "audioDuration": 2.712,
                    "deliveryNotes": [
                        "Matter-of-fact, with quiet concern."
                    ]
                },
                {
                    "id": "cue-02",
                    "sceneId": "shot-2",
                    "sceneNumber": 2,
                    "heading": "Over shoulder \u00b7 eli",
                    "type": "dialogue",
                    "speaker": "Eli Rowan",
                    "text": "Then I am either very late or unexpectedly lucky.",
                    "startFrame": 94,
                    "durationFrames": 87,
                    "expressions": {
                        "mara": "skeptical",
                        "eli": "amused"
                    },
                    "shot": "ots-eli",
                    "action": "Eli rests his instrument case beside the bench.",
                    "audio": "/media/voices/a1a6353a1907b4f38ef745b6d17e5a5edcb46cb3348df0b6e3eb43247e30dfbd.mp3",
                    "audioDuration": 2.472,
                    "deliveryNotes": [
                        "Dry humor, lightly amused."
                    ]
                },
                {
                    "id": "cue-03",
                    "sceneId": "shot-3",
                    "sceneNumber": 3,
                    "heading": "Insert \u00b7 ticket in Eli\u2019s hand",
                    "type": "dialogue",
                    "speaker": "Mara Vale",
                    "text": "You are holding a ticket for yesterday.",
                    "startFrame": 181,
                    "durationFrames": 67,
                    "expressions": {
                        "mara": "skeptical",
                        "eli": "surprised"
                    },
                    "shot": "ticket",
                    "action": "She points at the date, without taking the ticket.",
                    "audio": "/media/voices/3e6ee143f1a8f91422eae9ccfd789077ac371f7f051cd869aa32932befd02c4d.mp3",
                    "audioDuration": 1.824,
                    "deliveryNotes": [
                        "Pointedly, with a raised eyebrow."
                    ]
                },
                {
                    "id": "cue-04",
                    "sceneId": "shot-4",
                    "sceneNumber": 4,
                    "heading": "Wide \u00b7 Eli on the bench",
                    "type": "dialogue",
                    "speaker": "Eli Rowan",
                    "text": "That would explain the unusually quiet carriage.",
                    "startFrame": 248,
                    "durationFrames": 95,
                    "expressions": {
                        "mara": "amused",
                        "eli": "amused"
                    },
                    "shot": "wide-sitting",
                    "action": "He turns the ticket over, then admits the joke with a smile.",
                    "audio": "/media/voices/24750b0ad5e4fa385aca1611a4778815e29a645f431d9994a10885134f4f6cc3.mp3",
                    "audioDuration": 2.736,
                    "deliveryNotes": [
                        "A gentle self-deprecating joke."
                    ]
                },
                {
                    "id": "cue-05",
                    "sceneId": "shot-5",
                    "sceneNumber": 5,
                    "heading": "Over shoulder \u00b7 mara",
                    "type": "dialogue",
                    "speaker": "Mara Vale",
                    "text": "Please tell me you did not spend the night on a parked train.",
                    "startFrame": 343,
                    "durationFrames": 108,
                    "expressions": {
                        "mara": "concerned",
                        "eli": "neutral"
                    },
                    "shot": "ots-mara",
                    "action": "Her smile fades; she studies his face.",
                    "audio": "/media/voices/5b3ed3dd61c70e73be9b6e7c505a25b66cdb4fb85d93982cc20fe30ba069833a.mp3",
                    "audioDuration": 3.192,
                    "deliveryNotes": [
                        "Concerned, speaking directly to him."
                    ]
                },
                {
                    "id": "cue-06",
                    "sceneId": "shot-6",
                    "sceneNumber": 6,
                    "heading": "Over shoulder \u00b7 eli",
                    "type": "dialogue",
                    "speaker": "Eli Rowan",
                    "text": "Only the evening. I was tuning the piano in the station caf\u00e9.",
                    "startFrame": 451,
                    "durationFrames": 110,
                    "expressions": {
                        "mara": "surprised",
                        "eli": "neutral"
                    },
                    "shot": "ots-eli",
                    "action": "He taps the small case: tools, not luggage.",
                    "audio": "/media/voices/69a31e721bc2e53f717871f6573681edff16bda917b242a606fc9a873a5d55b4.mp3",
                    "audioDuration": 3.24,
                    "deliveryNotes": [
                        "Reassuring, unhurried."
                    ]
                },
                {
                    "id": "cue-07",
                    "sceneId": "shot-7",
                    "sceneNumber": 7,
                    "heading": "Close-up \u00b7 mara",
                    "type": "dialogue",
                    "speaker": "Mara Vale",
                    "text": "They closed that caf\u00e9 last winter.",
                    "startFrame": 561,
                    "durationFrames": 66,
                    "expressions": {
                        "mara": "concerned",
                        "eli": "concerned"
                    },
                    "shot": "closeup-mara",
                    "action": "A gust moves the hanging station sign.",
                    "audio": "/media/voices/0e987083c227864fa6f87c2eaab99319a49a503ce014c5312a9920097cbf9b2a.mp3",
                    "audioDuration": 1.776,
                    "deliveryNotes": [
                        "Softly, surprised.",
                        "pace=slow"
                    ]
                },
                {
                    "id": "cue-08",
                    "sceneId": "shot-8",
                    "sceneNumber": 8,
                    "heading": "Close-up \u00b7 eli",
                    "type": "dialogue",
                    "speaker": "Eli Rowan",
                    "text": "I know. My sister used to play there. I promised I would keep it in tune.",
                    "startFrame": 627,
                    "durationFrames": 154,
                    "expressions": {
                        "mara": "concerned",
                        "eli": "concerned"
                    },
                    "shot": "closeup-eli",
                    "action": "He looks toward the dark caf\u00e9 windows.",
                    "audio": "/media/voices/846c54c35c900b6677c1a531851dcf46795b5e71463bb55600c11c6e4c811bd8.mp3",
                    "audioDuration": 4.728,
                    "deliveryNotes": [
                        "Hushed and intimate; pause after I know.",
                        "pace=slow vol=x-soft"
                    ]
                },
                {
                    "id": "cue-09",
                    "sceneId": "shot-9",
                    "sceneNumber": 9,
                    "heading": "Over shoulder \u00b7 mara",
                    "type": "dialogue",
                    "speaker": "Mara Vale",
                    "text": "They should have left you a light.",
                    "startFrame": 781,
                    "durationFrames": 53,
                    "expressions": {
                        "mara": "angry",
                        "eli": "surprised"
                    },
                    "shot": "ots-mara",
                    "action": "Mara looks toward the locked office, angry on his behalf.",
                    "audio": "/media/voices/09320205419668bd2feb8f9852b1d69b71859b338acd989be17a62c70a8ac17c.mp3",
                    "audioDuration": 1.344,
                    "deliveryNotes": [
                        "Quiet anger on his behalf, controlled.",
                        "pace=slow"
                    ]
                },
                {
                    "id": "cue-10",
                    "sceneId": "shot-10",
                    "sceneNumber": 10,
                    "heading": "Over shoulder \u00b7 eli",
                    "type": "dialogue",
                    "speaker": "Eli Rowan",
                    "text": "There was enough moonlight. Not enough coffee.",
                    "startFrame": 834,
                    "durationFrames": 92,
                    "expressions": {
                        "mara": "amused",
                        "eli": "amused"
                    },
                    "shot": "ots-eli",
                    "action": "He lifts his shoulders; she lets out a small laugh.",
                    "audio": "/media/voices/0b3ef439ec1ac66683f2079b7beed752dd059e6597a38329a2d244d6e2429f4c.mp3",
                    "audioDuration": 2.664,
                    "deliveryNotes": [
                        "Warm dry humor; pause before coffee."
                    ]
                },
                {
                    "id": "cue-11",
                    "sceneId": "shot-11",
                    "sceneNumber": 11,
                    "heading": "Wide two-shot",
                    "type": "dialogue",
                    "speaker": "Mara Vale",
                    "text": "Come inside. I have coffee, and the morning timetable.",
                    "startFrame": 926,
                    "durationFrames": 97,
                    "expressions": {
                        "mara": "amused",
                        "eli": "surprised"
                    },
                    "shot": "wide",
                    "action": "She unlocks the warm-lit office door.",
                    "audio": "/media/voices/53aa3ff6ea952bdc366e681e59bd5e30490994d309c52b05909aa1e51f293a38.mp3",
                    "audioDuration": 2.832,
                    "deliveryNotes": [
                        "Warmly inviting, with a small smile."
                    ]
                },
                {
                    "id": "cue-12",
                    "sceneId": "shot-12",
                    "sceneNumber": 12,
                    "heading": "Wide two-shot",
                    "type": "dialogue",
                    "speaker": "Eli Rowan",
                    "text": "Then perhaps this is the right ticket after all.",
                    "startFrame": 1023,
                    "durationFrames": 86,
                    "expressions": {
                        "mara": "amused",
                        "eli": "amused"
                    },
                    "shot": "wide",
                    "action": "They turn toward the light together.",
                    "audio": "/media/voices/ae07c4fddbe386949d957581d4e70709d001c7327b5063b426ca8e355c2df5c4.mp3",
                    "audioDuration": 2.448,
                    "deliveryNotes": [
                        "Grateful, quietly amused.",
                        "pace=slow"
                    ]
                }
            ],
            "setBrief": {
                "name": "North Platform",
                "location": "A small railway platform at blue hour. Warm station windows, a wooden bench, quiet rails and violet hills. No other people.",
