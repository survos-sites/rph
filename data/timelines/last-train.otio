                                "sceneId": "shot-1",
                                "sceneNumber": 1,
                                "heading": "Wide two-shot",
                                "type": "dialogue",
                                "speaker": "Mara Vale",
                                "text": "The last train was supposed to leave eight minutes ago.",
                                "startFrame": 0,
                                "durationFrames": 94,
                                "expressions": {
                                    "mara": "concerned",
                                    "eli": "neutral"
                                },
                                "shot": "wide",
                                "action": "Mara checks the empty platform.",
                                "audio": "/media/voices/1fa50e25bad58b4658c529f8cd8fa51f296743c1d3ccdb94f63c1047fdb96004.mp3",
                                "audioDuration": 2.712,
                                "deliveryNotes": [
                                    "Matter-of-fact, with quiet concern."
                                ],
