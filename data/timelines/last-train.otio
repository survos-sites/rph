                                "type": "dialogue",
                                "speaker": "Eli Rowan",
                                "text": "There was enough moonlight. Not enough coffee.",
                                "startFrame": 834,
                                "durationFrames": 92,
                                "expressions": {
                                    "mara": "amused",
                                    "eli": "amused"
                                },
                                "shot": "ots-eli",
