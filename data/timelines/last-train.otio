                                "sceneNumber": 6,
                                "heading": "Over shoulder \u00b7 eli",
                                "type": "dialogue",
                                "speaker": "Eli Rowan",
                                "text": "Only the evening. I was tuning the piano in the station caf\u00e9.",
                                "startFrame": 451,
                                "durationFrames": 110,
                                "expressions": {
                                    "mara": "surprised",
                                    "eli": "neutral"
                                },
                                "shot": "ots-eli",
                                "action": "He taps the small case: tools, not luggage.",
                                "audio": "/media/voices/69a31e721bc2e53f717871f6573681edff16bda917b242a606fc9a873a5d55b4.mp3",
                                "audioDuration": 3.24,
                                "deliveryNotes": [
                                    "Reassuring, unhurried."
                                ]
                            }
                        },
                        "media_references": {
