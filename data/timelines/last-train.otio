                                "type": "dialogue",
                                "speaker": "Eli Rowan",
                                "text": "I know. My sister used to play there. I promised I would keep it in tune.",
                                "startFrame": 627,
                                "durationFrames": 154,
                                "expressions": {
                                    "mara": "concerned",
                                    "eli": "concerned"
                                },
                                "shot": "closeup-eli",
