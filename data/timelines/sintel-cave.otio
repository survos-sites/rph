            "cues": [
                {
                    "id": "sintel-cave-1:1",
                    "speaker": "Shaman",
                    "text": "This blade has a dark past.",
                    "startFrame": 9,
                    "durationFrames": 57,
                    "sourceStart": 106.875,
                    "sourceEnd": 109.25,
                    "subtitleStart": 107.25,
                    "subtitleEnd": 110.5,
                    "type": "dialogue",
                    "sceneId": "shot-1",
                    "sceneNumber": 1,
                    "heading": "Blade and fire"
                },
                {
                    "id": "sintel-cave-1:2",
                    "speaker": "Shaman",
                    "text": "It has shed much innocent blood.",
                    "startFrame": 117,
                    "durationFrames": 64,
                    "sourceStart": 111.375,
                    "sourceEnd": 114.04166666666667,
                    "subtitleStart": 111.8,
                    "subtitleEnd": 115.8,
                    "type": "dialogue",
                    "sceneId": "shot-2",
                    "sceneNumber": 2,
                    "heading": "Shaman examines the blade"
                },
                {
                    "id": "sintel-cave-1:3",
                    "speaker": "Shaman",
                    "text": "You're a fool for traveling alone, so completely unprepared.",
                    "startFrame": 265,
                    "durationFrames": 70,
                    "sourceStart": 117.54166666666667,
                    "sourceEnd": 120.45833333333333,
                    "subtitleStart": 118,
                    "subtitleEnd": 121.45,
                    "type": "dialogue",
                    "sceneId": "shot-3",
                    "sceneNumber": 3,
                    "heading": "Over Sintel\u2019s shoulder"
                },
                {
                    "id": "sintel-cave-1:4",
                    "speaker": "Shaman",
                    "text": "You're lucky your blood's still flowing.",
                    "startFrame": 352,
                    "durationFrames": 43,
                    "sourceStart": 121.16666666666667,
                    "sourceEnd": 122.95833333333333,
                    "subtitleStart": 121.75,
                    "subtitleEnd": 124.8,
                    "type": "dialogue",
                    "sceneId": "shot-5",
                    "sceneNumber": 5,
                    "heading": "The shaman offers a bowl"
                },
                {
                    "id": "sintel-cave-1:5",
                    "speaker": "Sintel",
                    "text": "Thank you.",
                    "startFrame": 438,
                    "durationFrames": 19,
                    "sourceStart": 124.75,
                    "sourceEnd": 125.54166666666667,
                    "subtitleStart": 125.25,
                    "subtitleEnd": 126.3,
                    "type": "dialogue",
                    "sceneId": "shot-6",
                    "sceneNumber": 6,
                    "heading": "Sintel accepts the bowl"
                },
                {
                    "id": "sintel-cave-1:6",
                    "speaker": "Shaman",
                    "text": "So...",
                    "startFrame": 498,
                    "durationFrames": 16,
                    "sourceStart": 127.25,
                    "sourceEnd": 127.91666666666667,
                    "subtitleStart": 127.5,
                    "subtitleEnd": 129,
                    "type": "dialogue",
                    "sceneId": "shot-7",
                    "sceneNumber": 7,
                    "heading": "Wide conversation"
                },
                {
                    "id": "sintel-cave-1:7",
                    "speaker": "Shaman",
                    "text": "What brings you to the land of the gatekeepers?",
                    "startFrame": 539,
                    "durationFrames": 60,
                    "sourceStart": 128.95833333333334,
                    "sourceEnd": 131.45833333333334,
                    "subtitleStart": 129.4,
                    "subtitleEnd": 133.8,
                    "type": "dialogue",
                    "sceneId": "shot-7",
                    "sceneNumber": 7,
                    "heading": "Wide conversation"
                },
                {
                    "id": "sintel-cave-1:8",
                    "speaker": "Sintel",
                    "text": "I'm searching for someone.",
                    "startFrame": 683,
                    "durationFrames": 35,
                    "sourceStart": 134.95833333333334,
                    "sourceEnd": 136.41666666666666,
                    "subtitleStart": 135,
                    "subtitleEnd": 137.5,
                    "type": "dialogue",
                    "sceneId": "shot-9",
                    "sceneNumber": 9,
                    "heading": "Bowl reflection"
                },
                {
                    "id": "sintel-cave-1:9",
                    "speaker": "Shaman",
                    "text": "Someone very dear? A kindred spirit?",
                    "startFrame": 744,
                    "durationFrames": 79,
                    "sourceStart": 137.5,
                    "sourceEnd": 140.79166666666666,
                    "subtitleStart": 138,
                    "subtitleEnd": 142.2,
                    "type": "dialogue",
                    "sceneId": "shot-9",
                    "sceneNumber": 9,
                    "heading": "Bowl reflection"
                },
                {
                    "id": "sintel-cave-1:10",
                    "speaker": "Sintel",
                    "text": "A dragon.",
                    "startFrame": 880,
                    "durationFrames": 20,
                    "sourceStart": 143.16666666666666,
                    "sourceEnd": 144,
                    "subtitleStart": 143.4,
                    "subtitleEnd": 145,
                    "type": "dialogue",
                    "sceneId": "shot-11",
                    "sceneNumber": 11,
                    "heading": "Sintel remembers"
                },
                {
                    "id": "sintel-cave-1:11",
                    "speaker": "Shaman",
                    "text": "A dangerous quest for a lone hunter.",
                    "startFrame": 1016,
                    "durationFrames": 53,
                    "sourceStart": 148.83333333333334,
                    "sourceEnd": 151.04166666666666,
                    "subtitleStart": 148.85,
                    "subtitleEnd": 151.75,
                    "type": "dialogue",
                    "sceneId": "shot-12",
                    "sceneNumber": 12,
                    "heading": "Leaving the cave"
                },
                {
                    "id": "sintel-cave-1:12",
                    "speaker": "Sintel",
                    "text": "I've been alone for as long as I can remember.",
                    "startFrame": 1116,
                    "durationFrames": 52,
                    "sourceStart": 153,
                    "sourceEnd": 155.16666666666666,
                    "subtitleStart": 152.95,
                    "subtitleEnd": 155.8333333333,
                    "type": "dialogue",
                    "sceneId": "shot-13",
                    "sceneNumber": 13,
                    "heading": "City flashback"
                }
            ],
