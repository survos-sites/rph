{
    "type": "project",
    "name": "survos-sites/rph",
    "description": "Role Playhouse for importing, casting, and rehearsing scripts",
    "license": "proprietary",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-pdo_pgsql": "*",
        "ext-zip": "*",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7.3",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3.6",
        "survos/fetch-bundle": "^2.41",
        "survos/field-bundle": "^2.43.23",
        "survos/omc": "@dev",
        "survos/otio": "^2.41.9",
        "survos/otio-bundle": "*",
        "survos/search-bundle": "^2.45.10",
        "survos/supervisor-bundle": "^2.45",
        "survos/tabler-bundle": "dev-main",
        "survos/workflow-extras-bundle": "^2.42.13",
        "survos/workflow-messenger-bundle": "^2.42.13",
        "symfony/ai-generic-platform": "dev-generic-tts as 1.0.0-BETA2",
        "symfony/ai-platform": "dev-main as 1.0.0-BETA2",
        "symfony/asset": "^8.2",
        "symfony/asset-mapper": "^8.2",
        "symfony/console": "^8.2",
        "symfony/doctrine-messenger": "^8.2",
        "symfony/dotenv": "^8.2",
        "symfony/expression-language": "^8.2",
        "symfony/flex": "^2",
        "symfony/form": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-client": "^8.2",
        "symfony/intl": "^8.2",
        "symfony/mailer": "^8.2",
        "symfony/mcp-bundle": "dev-main",
        "symfony/mime": "^8.2",
        "symfony/monolog-bundle": "^3.0|^4.1",
        "symfony/notifier": "^8.2",
        "symfony/process": "^8.2",
        "symfony/property-access": "^8.2",
        "symfony/property-info": "^8.2",
        "symfony/runtime": "^8.2",
        "symfony/security-bundle": "^8.2",
        "symfony/serializer": "^8.2",
        "symfony/stimulus-bundle": "^3.5.1",
        "symfony/string": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/ux-turbo": "^3.5.1",
        "symfony/validator": "^8.2",
        "symfony/web-link": "^8.2",
        "symfony/workflow": "^8.2",
        "symfony/yaml": "^8.2",
        "twig/extra-bundle": "^2.12|^3.29",
        "twig/twig": "^2.12|^3.30"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": false,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "survos/deployment-bundle": "^2.34.38",
        "symfony/browser-kit": "^8.2",
        "symfony/css-selector": "^8.2",
        "symfony/debug-bundle": "^8.2",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "^8.2",
        "symfony/web-profiler-bundle": "^8.2"
    },
    "repositories": [{
        "name": "ai-generic-platform",
        "type": "vcs",
        "url": "https://github.com/tacman/ai-generic-platform"
    },{
        "name": "omc-working",
        "type": "path",
        "url": "../mono/lib/omc"
    }]
}
